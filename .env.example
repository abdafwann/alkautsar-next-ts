# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/alkautsar_db"
DIRECT_URL="postgresql://user:password@localhost:5432/alkautsar_db"

# Cloudinary (Image Uploads)
CLOUD_NAME="your-cloud-name"
API_KEY="your-cloudinary-api-key"
SECRET_KEY="your-cloudinary-secret-key"

# Resend (Email Service)
RESEND_API_KEY="re_your_resend_api_key"

# Midtrans Payment Gateway
ID_MERCHANT="your-merchant-id"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-your-client-key"
MIDTRANS_SERVER_KEY="Mid-server-your-server-key"

# Upstash Redis (Rate Limiting & Caching)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Authentication & Security
JWT_SECRET="your-32-character-jwt-secret-key"
MASTER_SECURITY_CODE="your-admin-master-pin"
VALID_MASTER_KEY="your-admin-master-pin"
